{
  "name": "toby-zh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.background.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.ts",
    "test:e2e": "playwright test",
    "test:extension": "npm run build && playwright test --config playwright.extension.config.ts",
    "format": "prettier --write src tests public *.ts *.json *.html README.md",
    "build:fixed-id": "npm run build && node scripts/build-fixed-id.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "author": "Orange8",
  "repository": {
    "type": "git",
    "url": "https://github.com/Orange8/toby-zh.git"
  },
  "homepage": "https://github.com/Orange8/toby-zh#readme",
  "bugs": {
    "url": "https://github.com/Orange8/toby-zh/issues"
  }
}
